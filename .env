# Milvus
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB=default

# PostgreSQL
PG_DSN=postgresql://user:password@host:5432/dbname

# Jina V4 Embedding Model (local inference)
# Local directory under project root (checked before JINA_MODEL_NAME)
JINA_MODEL_PATH=models/jina-embeddings-v4
JINA_MODEL_NAME=jinaai/jina-embeddings-v4
JINA_EMBEDDING_DIM=1024
JINA_EMBEDDING_TASK=retrieval
JINA_PARAGRAPH_MODE=averaged
RAG_TABLE_PREFIX=rag_nodes

# Milvus
MILVUS_URI=https://in03-1b096fda18d08de.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=175d85ee979ef0ea5335a77f7faae21b06318ff5eec0c3ccd7e0e56d819c62292c06d536610eccdd0c7e593ef2ee4d3292d05110
MILVUS_DB=default
MILVUS_IO_WORKERS=8

# Embedding（OpenAI 兼容网关；留空 BASE_URL/API_KEY 则与 Planner 共用）
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BASE_URL=https://llm-gw.bupt.edu.cn/v1
EMBEDDING_API_KEY=sk-IZejGuUOy4m4aEndSRcOq9SdbGeiBfRUUF96dF72i38pqMq6
# 换 embedding 模型后需用新 collection 并重新入库
RAG_VEC_COLLECTION_SUFFIX=v1
PARAGRAPH_MODE=averaged
RAG_TABLE_PREFIX=rag_nodes

# Query Planner（OpenAI 兼容网关，用于检索 query 扩写）
PLANNER_BASE_URL=https://llm-gw.bupt.edu.cn/v1
PLANNER_API_KEY=sk-IZejGuUOy4m4aEndSRcOq9SdbGeiBfRUUF96dF72i38pqMq6
PLANNER_MODEL=qwen-latest
PLANNER_ENABLE_THINKING=false
PLANNER_MAX_QUERIES=3

# Upstash Redis（job 状态 + 检索缓存）
REDIS_URL=rediss://default:gQAAAAAAAkXLAAIgcDE2NGM3NjEzYjVkMTg0M2MyYTZhNTcyY2IxZWJmNzEzOA@concrete-guppy-148939.upstash.io:6379
JOB_TTL_SECONDS=3600
RAG_CACHE_TTL_SECONDS=3600
RAG_CACHE_ENABLED=true
UPLOAD_DIR=data/uploads

# 检索参数（可选）
RETRIEVAL_TOP_K=8
RETRIEVAL_BM25_TOP_K=4
RERANK_STRATEGY=combined
TOP_K_FINAL=20
PARENT_DEPTH=1
CHILD_DEPTH=0
SNIPPET_DEDUP=tree

# 入库写队列（低优先级，限流）
INGESTION_MAX_CONCURRENT=2
INGESTION_QUEUE_MAX_SIZE=64
INGESTION_YIELD_TO_RETRIEVAL=true
INGESTION_YIELD_POLL_SECONDS=0.05
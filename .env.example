# Milvus
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB=
MILVUS_IO_WORKERS=

# Embedding（OpenAI 兼容网关；留空 BASE_URL/API_KEY 则与 Planner 共用）
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_BATCH_SIZE=
# 单次 embedding 上限（低于 bge-m3 8192 token）；超长段先按句切节点，再在此处分窗聚合
EMBEDDING_MAX_CHARS=
EMBEDDING_WINDOW_OVERLAP=
MAX_PARAGRAPH_CHARS=
MAX_SENTENCE_CHARS=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 换 embedding / 聚合方式 / paragraph_mode 后需用新 collection 并重新入库
RAG_VEC_COLLECTION_SUFFIX=
PARAGRAPH_MODE=
RAG_TABLE_PREFIX=

# Query Planner（OpenAI 兼容网关，用于检索 query 扩写）
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
PLANNER_ENABLE_THINKING=
PLANNER_MAX_QUERIES=

# Upstash Redis（job 状态 + 检索缓存）
# 有 REST 时优先走 HTTPS（校园网拦 6379 也能用）；否则用 REDIS_URL 的 TCP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
JOB_TTL_SECONDS=
RAG_CACHE_TTL_SECONDS=
RAG_CACHE_ENABLED=
UPLOAD_DIR=

# 检索参数（可选）
RETRIEVAL_TOP_K=
RETRIEVAL_BM25_TOP_K=
RERANK_STRATEGY=
TOP_K_FINAL=
PARENT_DEPTH=
CHILD_DEPTH=
INCLUDE_SIBLINGS=
MAX_SIBLINGS=
SNIPPET_RETURN_MODE=
SNIPPET_DEDUP=

# Cross-encoder rerank（BUPT 网关 jina-reranker-m0）
RERANK_ENABLED=
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_CANDIDATES=
RERANK_TOP_N=

# 生成侧 /v1/answer
ANSWER_MAX_RETRIES=
ANSWER_K_DELTA=
ANSWER_ENSEMBLE_SIZE=
ANSWER_TEMPERATURE=
ANSWER_IGNORE_BLANK=

# 入库写队列（低优先级，限流）
INGESTION_MAX_CONCURRENT=
INGESTION_QUEUE_MAX_SIZE=
INGESTION_YIELD_TO_RETRIEVAL=
INGESTION_YIELD_POLL_SECONDS=
